# Save a Train vendor API
SAT_API_BASE_URL=https://vendor.saveatrain.com
SAT_AGENT_EMAIL=agent@example.com
SAT_AGENT_TOKEN=replace-me
# Server's outbound IP - must be whitelisted by SAT.
SAT_FORWARDED_FOR=203.0.113.5

# MongoDB (Atlas - requires Atlas Search index "autocomplete" on station_search_names.name).
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
MONGO_DB=sat

# Optional: override .env file location (useful when launched by Claude Desktop with an unpredictable CWD).
# SAT_MCP_ENV_FILE=/absolute/path/to/.env
